<Window x:Class="DesktopCalendar.App.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="일정 편집" Width="360" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: 제목 라벨 -->
            <RowDefinition Height="Auto" />  <!-- 1: 제목 입력 -->
            <RowDefinition Height="Auto" />  <!-- 2: 종일 -->
            <RowDefinition Height="Auto" />  <!-- 3: 날짜 -->
            <RowDefinition Height="Auto" />  <!-- 4: 시간 -->
            <RowDefinition Height="Auto" />  <!-- 5: 안내문 -->
            <RowDefinition Height="Auto" />  <!-- 6: 반복 -->
            <RowDefinition Height="Auto" />  <!-- 7: 색상/알림 라벨 -->
            <RowDefinition Height="Auto" />  <!-- 8: 색상/알림 -->
            <RowDefinition Height="Auto" />  <!-- 9: 메모 라벨 -->
            <RowDefinition Height="*" />     <!-- 10: 메모 -->
            <RowDefinition Height="Auto" />  <!-- 11: 버튼 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="제목" Margin="0,0,0,4" />
        <TextBox Grid.Row="1" Name="TitleBox" Margin="0,0,0,10" />

        <CheckBox Grid.Row="2" Name="IsAllDayCheckBox" Content="종일" Margin="0,0,0,8"
                   Checked="IsAllDayCheckBox_CheckedChanged" Unchecked="IsAllDayCheckBox_CheckedChanged" />

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <DockPanel Margin="0,0,0,4" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="시작 날짜" />
                    <!-- 음력 생일·제사처럼 음력으로 날짜를 아는 경우를 위한 입력 창 -->
                    <Button DockPanel.Dock="Right" Name="LunarPickButton" Content="음력으로..."
                            Padding="6,0" FontSize="11" Click="LunarPickButton_Click" />
                </DockPanel>
                <DatePicker Name="StartDatePicker" SelectedDateChanged="StartDatePicker_SelectedDateChanged" />
                <TextBlock Name="LunarHintText" FontSize="10" Foreground="Gray" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="종료 날짜" Margin="0,0,0,4" />
                <DatePicker Name="EndDatePicker" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="시작 시간 (HH:mm)" Margin="0,0,0,4" />
                <TextBox Name="StartTimeBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="종료 시간 (HH:mm)" Margin="0,0,0,4" />
                <TextBox Name="EndTimeBox" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" Text="여러 날에 걸친 일정은 종료 날짜를 다르게 지정하세요."
                    Foreground="Gray" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />

        <Grid Grid.Row="6" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="반복" Margin="0,0,0,4" />
                <ComboBox Name="RecurrenceComboBox" DisplayMemberPath="Label"
                          SelectionChanged="RecurrenceComboBox_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="반복 종료 (비우면 계속)" Margin="0,0,0,4" />
                <DatePicker Name="RecurrenceUntilPicker" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="7" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="색상" />
            <TextBlock Grid.Column="2" Text="알림" />
        </Grid>
        <Grid Grid.Row="8" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" Name="ColorPanel" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" Name="ReminderComboBox" VerticalAlignment="Center"
                      DisplayMemberPath="Label" />
        </Grid>

        <TextBlock Grid.Row="9" Text="메모" Margin="0,0,0,4" />
        <TextBox Grid.Row="10" Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" MinHeight="60" />

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="SaveButton" Content="저장" Width="70" Margin="0,0,6,0" Click="SaveButton_Click" IsDefault="True" />
            <Button Name="CancelButton" Content="취소" Width="70" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
