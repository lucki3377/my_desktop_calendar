<Window x:Class="DesktopCalendar.App.AppearanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="색상 / 투명도" Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="바탕 색상" FontWeight="Bold" Margin="0,0,0,6" />

        <!-- 프리셋 색상 -->
        <WrapPanel Grid.Row="1" Name="PresetPanel" Margin="0,0,0,12" />

        <!-- RGB 슬라이더 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="R" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" Name="RedSlider" Minimum="0" Maximum="255"
                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="ColorSlider_ValueChanged" />
            <TextBlock Grid.Row="0" Grid.Column="2" Name="RedValueText" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="G" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Name="GreenSlider" Minimum="0" Maximum="255"
                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="ColorSlider_ValueChanged" />
            <TextBlock Grid.Row="1" Grid.Column="2" Name="GreenValueText" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="B" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" Name="BlueSlider" Minimum="0" Maximum="255"
                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="ColorSlider_ValueChanged" />
            <TextBlock Grid.Row="2" Grid.Column="2" Name="BlueValueText" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- 투명도 -->
        <TextBlock Grid.Row="3" Text="불투명도" FontWeight="Bold" Margin="0,16,0,6" />
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0" Name="OpacitySlider" Minimum="10" Maximum="100"
                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="ColorSlider_ValueChanged" />
            <TextBlock Grid.Column="1" Name="OpacityValueText" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- 미리보기: 배경화면 위에 얹힌 모습을 흉내내려고 뒤에 알록달록한 그라데이션을 깔았다 -->
        <Border Grid.Row="5" Margin="0,16,0,0" CornerRadius="6" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6B8FB5" Offset="0" />
                    <GradientStop Color="#C99AA6" Offset="0.5" />
                    <GradientStop Color="#E0C08A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Border Name="PreviewPanel" Margin="26" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Name="PreviewTitle" Text="2026년 8월" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Name="PreviewSunday" Text="일" Margin="0,0,14,0" />
                        <TextBlock Name="PreviewWeekday" Text="월  화  수  목  금" Margin="0,0,14,0" />
                        <TextBlock Name="PreviewSaturday" Text="토" />
                    </StackPanel>
                    <TextBlock Name="PreviewHoliday" Text="15  광복절" Margin="0,8,0,0" />
                    <Border Name="PreviewChip" CornerRadius="3" Padding="4,2,4,2" Margin="0,6,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="09:00 회의" Foreground="White" FontSize="11" />
                    </Border>
                    <TextBlock Name="PreviewHint" Text="드래그: 이동 / 날짜 클릭: 일정" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <DockPanel Grid.Row="6" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Name="ResetButton" Content="기본값" Width="70" Click="ResetButton_Click" />
            <Button DockPanel.Dock="Right" Name="CancelButton" Content="취소" Width="70" Click="CancelButton_Click" IsCancel="True" />
            <Button DockPanel.Dock="Right" Name="ApplyButton" Content="적용" Width="70" Margin="0,0,6,0" Click="ApplyButton_Click" IsDefault="True" />
        </DockPanel>
    </Grid>
</Window>
