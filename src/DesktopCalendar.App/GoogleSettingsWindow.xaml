<Window x:Class="DesktopCalendar.App.GoogleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="구글 캘린더 연동" Width="480" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#555555"
                   Text="Google Cloud Console에서 '데스크톱 앱' 유형의 OAuth 2.0 클라이언트를 직접 만든 뒤, 발급받은 클라이언트 ID/보안 비밀을 입력하세요. 구글 일정은 읽기 전용으로만 가져옵니다." />

        <TextBlock Grid.Row="1" Margin="0,12,0,4" Text="클라이언트 ID" />
        <TextBox Grid.Row="2" Name="ClientIdBox" />

        <TextBlock Grid.Row="3" Margin="0,8,0,4" Text="클라이언트 보안 비밀" />
        <TextBox Grid.Row="4" Name="ClientSecretBox" />

        <!-- 연결 상태 -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="ConnectionStatusText" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="연결 상태: 확인 중..." />
            <Button Grid.Column="1" Name="ConnectButton" Content="구글 계정 연결" Width="110" Margin="6,0,0,0"
                    Click="ConnectButton_Click" />
            <Button Grid.Column="2" Name="DisconnectButton" Content="연결 해제" Width="80" Margin="6,0,0,0"
                    Click="DisconnectButton_Click" />
        </Grid>

        <TextBlock Grid.Row="6" Margin="0,14,0,4" Text="연동할 캘린더" />
        <ListBox Grid.Row="7" Name="CalendarListBox" MinHeight="140">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 표시/동기화 옵션 -->
        <StackPanel Grid.Row="8" Margin="0,12,0,0">
            <CheckBox Name="ShowEventsCheckBox" Content="위젯에 구글 일정 표시" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="동기화 주기(분)" VerticalAlignment="Center" />
                <TextBox Name="SyncIntervalBox" Width="60" Margin="8,0,0,0" />
                <Button Name="SyncNowButton" Content="지금 동기화" Width="90" Margin="12,0,0,0"
                        Click="SyncNowButton_Click" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="9" Name="SyncStatusText" Margin="0,8,0,0" Foreground="#555555"
                   TextWrapping="Wrap" Text="마지막 동기화: 없음" />

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Name="SaveButton" Content="저장" Width="70" Margin="0,0,6,0" Click="SaveButton_Click" IsDefault="True" />
            <Button Name="CancelButton" Content="닫기" Width="70" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
