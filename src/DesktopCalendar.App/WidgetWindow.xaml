<Window x:Class="DesktopCalendar.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="DesktopCalendar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="Manual">

    <Grid>
        <!-- 반투명 패널 배경 (DESIGN.md 결정 사항: 가독성 확보) -->
        <Border Name="PanelBorder"
                Background="#B3202020"
                CornerRadius="10"
                MouseLeftButtonDown="PanelBorder_MouseLeftButtonDown"
                MouseLeftButtonUp="PanelBorder_MouseLeftButtonUp"
                MouseMove="PanelBorder_MouseMove">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Name="LockMenuItem" Header="위치 잠금" IsCheckable="True" Click="LockMenuItem_Click" />
                    <MenuItem Header="공휴일 API 키 설정..." Click="ApiKeySettingsMenuItem_Click" />
                    <MenuItem Header="구글 캘린더 연동..." Click="GoogleSettingsMenuItem_Click" />
                    <MenuItem Header="글자 크기 조절..." Click="FontSizeMenuItem_Click" />
                    <MenuItem Header="색상 / 투명도..." Click="AppearanceMenuItem_Click" />
                    <!-- 체크 상태가 바뀌는 것 자체에 반응해야 하므로 Click이 아니라 Checked/Unchecked를 쓴다 -->
                    <MenuItem Name="MondayStartMenuItem" Header="월요일 시작" IsCheckable="True"
                              Checked="MondayStartMenuItem_CheckedChanged"
                              Unchecked="MondayStartMenuItem_CheckedChanged" />
                    <MenuItem Name="LunarMenuItem" Header="음력 표시" IsCheckable="True"
                              Checked="LunarMenuItem_CheckedChanged"
                              Unchecked="LunarMenuItem_CheckedChanged" />
                    <MenuItem Header="D-day 관리..." Click="DDayManageMenuItem_Click" />
                    <MenuItem Header="백업 / 내보내기..." Click="BackupMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="도움말..." Click="HelpMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="종료" Click="ExitMenuItem_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <DockPanel Margin="10" LastChildFill="True">
                <!-- D-day 리스트 -->
                <WrapPanel DockPanel.Dock="Top" Name="DDayPanel" Margin="0,0,0,6" />

                <!-- 월 이동 헤더 -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="PrevMonthButton" Content="◀" Click="PrevMonth_Click"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            FontSize="13" Padding="6,0" Cursor="Hand" />
                    <TextBlock Grid.Column="1" Name="MonthYearText"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="14" FontWeight="Bold"
                               Cursor="Hand"
                               MouseLeftButtonDown="MonthYearText_MouseLeftButtonDown" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- 몇 달 넘겨본 뒤 이번 달로 한 번에 돌아오는 버튼 -->
                        <Button Name="TodayButton" Content="오늘" Click="TodayButton_Click"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                FontSize="11" Padding="6,0" Cursor="Hand" />
                        <Button Name="NextMonthButton" Content="▶" Click="NextMonth_Click"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                FontSize="13" Padding="6,0" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <!-- 요일 헤더 -->
                <UniformGrid DockPanel.Dock="Top" Name="WeekdayHeader" Columns="7" Margin="0,0,0,2" />

                <!-- 하단 안내문 -->
                <TextBlock DockPanel.Dock="Bottom" Name="HintText" Margin="0,6,0,0"
                           Foreground="#999999" FontSize="10"
                           Text="드래그: 이동 / 날짜 클릭: 일정 / 우클릭: 잠금·종료" />

                <!-- 날짜 그리드 -->
                <UniformGrid Name="DaysGrid" Columns="7" Rows="6" />
            </DockPanel>
        </Border>

        <!-- 크기 조절 그립 (우하단) -->
        <Thumb Name="ResizeThumb"
               Width="16" Height="16"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Background="Transparent"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted" />
    </Grid>
</Window>
