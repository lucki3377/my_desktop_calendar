<Window x:Class="DesktopCalendar.App.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="백업 / 내보내기" Width="460" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#555555"
                   Text="일정과 D-day는 이 PC에만 저장됩니다. 가끔 백업 파일을 만들어 다른 곳(클라우드 폴더, USB 등)에 두면 PC를 초기화해도 되살릴 수 있습니다." />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="백업" FontWeight="Bold" Margin="0,0,0,6" />
            <Button Name="ExportButton" Content="백업 파일로 저장 (.json)" Height="32" Click="ExportButton_Click" />
            <TextBlock TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,4,0,0"
                       Text="일정, D-day, 직접 추가한 공휴일을 모두 담습니다." />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="복원" FontWeight="Bold" Margin="0,0,0,6" />
            <Button Name="ImportButton" Content="백업에서 복원 (.json)" Height="32" Click="ImportButton_Click" />
            <TextBlock TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,4,0,0"
                       Text="지금 있는 데이터에 합칩니다. 같은 항목은 백업 내용으로 덮어쓰고, 백업에 없는 항목은 지우지 않습니다." />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="다른 캘린더로 옮기기" FontWeight="Bold" Margin="0,0,0,6" />
            <Button Name="ExportIcsButton" Content="iCalendar로 내보내기 (.ics)" Height="32" Click="ExportIcsButton_Click" />
            <TextBlock TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,4,0,0"
                       Text="구글 캘린더·아웃룩 등에서 가져올 수 있는 표준 형식입니다. 일정만 담깁니다." />
        </StackPanel>

        <TextBlock Grid.Row="4" Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap"
                   VerticalAlignment="Top" Foreground="#2F6F3E" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="CloseButton" Content="닫기" Width="70" Click="CloseButton_Click" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
