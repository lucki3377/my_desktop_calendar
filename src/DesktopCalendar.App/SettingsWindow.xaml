<Window x:Class="DesktopCalendar.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="설정" Width="500" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="130" />
            <Setter Property="Height" Value="28" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <!-- ============ 표시 ============ -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="표시" Margin="0,0,0,8" />

                <TextBlock Text="글자 크기" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Name="FontScaleSlider" Minimum="70" Maximum="200"
                            IsSnapToTickEnabled="True" TickFrequency="5"
                            ValueChanged="FontScaleSlider_ValueChanged" />
                    <TextBlock Grid.Column="1" Name="FontScaleText" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="배경 색상 / 투명도" />
                        <TextBlock Name="ThemeSummaryText" Style="{StaticResource RowNote}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                            Name="AppearanceButton" Content="색상 / 투명도..." Click="AppearanceButton_Click" />
                </DockPanel>

                <CheckBox Name="MondayStartCheckBox" Content="한 주를 월요일부터 시작" Margin="0,14,0,0"
                          Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                <CheckBox Name="LunarCheckBox" Content="날짜 옆에 음력 표시" Margin="0,8,0,0"
                          Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />

                <!-- ============ 연동 ============ -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="연동" />

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="공휴일 (공공데이터포털)" />
                        <TextBlock Name="HolidayStatusText" Style="{StaticResource RowNote}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                            Name="ApiKeyButton" Content="API 키 설정..." Click="ApiKeyButton_Click" />
                </DockPanel>

                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="구글 캘린더" />
                        <TextBlock Name="GoogleStatusText" Style="{StaticResource RowNote}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                            Name="GoogleButton" Content="구글 연동..." Click="GoogleButton_Click" />
                </DockPanel>

                <CheckBox Name="ShowGoogleCheckBox" Content="위젯에 구글 일정 표시" Margin="0,12,0,0"
                          Checked="ShowGoogleCheckBox_Changed" Unchecked="ShowGoogleCheckBox_Changed" />

                <!-- ============ 데이터 ============ -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="데이터" />

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="백업 / 내보내기" />
                        <TextBlock Style="{StaticResource RowNote}"
                                   Text="일정·D-day를 파일로 저장하거나 되돌립니다." />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                            Name="BackupButton" Content="백업 / 내보내기..." Click="BackupButton_Click" />
                </DockPanel>

                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="D-day" />
                        <TextBlock Name="DDayStatusText" Style="{StaticResource RowNote}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                            Name="DDayButton" Content="D-day 관리..." Click="DDayButton_Click" />
                </DockPanel>

                <!-- ============ 시작 ============ -->
                <TextBlock Style="{StaticResource GroupTitle}" Text="시작" />

                <CheckBox Name="AutoStartCheckBox" Content="Windows 시작할 때 자동 실행"
                          Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed" />
                <TextBlock Name="AutoStartNoteText" Style="{StaticResource RowNote}" Margin="20,4,0,0" />

            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Name="HelpButton" Content="도움말..." Width="90" Height="28"
                    Click="HelpButton_Click" />
            <Button DockPanel.Dock="Right" Name="CloseButton" Content="닫기" Width="80" Height="28"
                    Click="CloseButton_Click" IsCancel="True" IsDefault="True" />
        </DockPanel>
    </Grid>
</Window>
